# База данных
DATABASE_URL=sqlite:///./exchange_rates.db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API
API_VERSION=1.0.0
API_TITLE="Exchange Rate API"
API_DESCRIPTION="API for currency exchange rates"

# Сборщик
COLLECTION_INTERVAL=3600  # в секундах
MAX_RETRIES=3
RETRY_DELAY=60  # в секундах
TIMEOUT=30  # в секундах
BANKS=cbr,ecb,federal_reserve,bank_of_england,bank_of_canada

# Логирование
LOG_LEVEL=INFO
LOG_FILE=rates_collector.log
MAX_LOG_SIZE=10485760  # 10MB
MAX_LOG_FILES=5

# Кэширование
CACHE_ENABLED=True
CACHE_SIZE=1000
CACHE_TTL=3600  # в секундах

# Метрики
METRICS_PORT=8001
API_KEY=LDkQpyURCVA4ci3ExqwWtohAj4nO0bkC
